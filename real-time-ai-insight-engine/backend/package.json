{
    "name": "ai-insight-engine-backend",
    "version": "1.0.0",
    "description": "Real-Time AI Insight Engine - Backend Service",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "producer": "tsx src/kafka/producer.ts",
        "worker": "tsx workers/kafka-consumer.ts",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:integration": "jest --config jest.integration.config.js",
        "format": "prettier --write \"src/**/*.{ts,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,json}\"",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "kafka",
        "confluent",
        "gemini",
        "ai",
        "real-time",
        "anomaly-detection"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@google/generative-ai": "^0.21.0",
        "@supabase/supabase-js": "^2.89.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "kafkajs": "^2.2.4",
        "socket.io": "^4.8.1",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.19.3",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.19.1",
        "@typescript-eslint/parser": "^8.19.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
